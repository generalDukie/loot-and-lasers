# Server-only local dev (optional — defaults work without this file)
PORT=8787
APP_ID=lootandlasers-local
JWT_SECRET=lootandlasers-dev-secret-change-me
DB_PATH=./data/game.db
PUBLIC_CLIENT_URL=http://localhost:8787

# Optional SMTP (enable email OTP + password reset links)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Production: set NODE_ENV=production and a strong JWT_SECRET
# NODE_ENV=production
