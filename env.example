# Copy to .env before: docker compose up -d
# Generate JWT_SECRET: openssl rand -hex 32

JWT_SECRET=replace-with-openssl-rand-hex-32
APP_ID=lootandlasers-local
PORT=8787
PUBLIC_CLIENT_URL=http://localhost:8787

# First-run admin (created by seed if missing)
SEED_EMAIL=admin@loot.local
SEED_PASSWORD=changeme

# Set false after initial seed to skip on every container start
RUN_SEED=true

# Optional SMTP (enable email OTP + password reset links)
# Leave SMTP_HOST empty to keep dev console codes.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
