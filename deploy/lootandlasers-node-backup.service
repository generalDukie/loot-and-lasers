[Unit]
Description=Loot & Lasers encrypted Node API backup
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile=/etc/lootandlasers/backup.env
WorkingDirectory=/opt/lootandlasers
ExecStart=/opt/lootandlasers/scripts/backup-node-api.sh
User=root
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
