# Install as /etc/lootandlasers/backup.env with mode 0600. Never commit the real file.
# Restic encrypts every snapshot with this password before sending it offsite.
RESTIC_REPOSITORY=s3:s3.example.com/lootandlasers-production
RESTIC_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_BACKUP_PASSWORD

# Provider credentials (example for S3-compatible storage):
AWS_ACCESS_KEY_ID=REPLACE_ME
AWS_SECRET_ACCESS_KEY=REPLACE_ME

BACKUP_KEEP_DAILY=7
BACKUP_KEEP_WEEKLY=5
BACKUP_KEEP_MONTHLY=12
BACKUP_LOCAL_RETENTION_DAYS=2
BACKUP_CHECK_SUBSET=5%
