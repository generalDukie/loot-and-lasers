#env
.env
.env.*
!.env.node-api.example

# Logs
/logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local
server/data/
server/node_modules/

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

.env
.vite

# Godot client caches (project lives in loot&lasers/)
**/loot&lasers/.godot/
**/.godot/

# Local auth cookie (browser/API session dump; never commit)
.cookie

# Cursor machine-local only (keep .cursor/rules/ and other shared project config tracked)
.cursor/cache/
.cursor/logs/
.cursor/tmp/
.cursor/**/*.log

# Secrets and local scratch directories
secrets/
tmp/
temp/

# OS junk
Thumbs.db

# Editor / backup leftovers
*~
*.bak
*.backup
*.orig

# Local database files (server/data/ already ignored above)
*.sqlite
*.sqlite3

# Docker host bind-mount data dirs (named volumes stay in Docker)
cockroach-data/
nakama-data/
docker-data/

# Nakama / Godot credential files if copied into the repo
# (runtime path is Godot user:// outside the project tree)
**/nakama_session.cfg
**/nakama_session_*.cfg
**/nakama_device_id.txt
**/nakama_device_id_*.txt
**/nakama_secrets.cfg
**/remote_config_cache.json
**/backend_env.cfg
